# Copy to .env and fill in. .env is git-ignored and never committed
# (architecture doc section 6). All keys are read with the OKAPI_ prefix.

OKAPI_DATABASE_URL=postgresql+psycopg://okapi:okapi@localhost:5432/okapi
OKAPI_OPA_URL=http://localhost:8181
OKAPI_JWT_SECRET=replace-with-a-long-random-string
OKAPI_JWT_ALGORITHM=HS256
OKAPI_ACCESS_TOKEN_TTL_SECONDS=900
OKAPI_ANTHROPIC_API_KEY=
